# Production — set in Netlify dashboard → Environment variables
NEXT_PUBLIC_STRAPI_URL=https://cms.yourdomain.com

# Groq — primary chat provider (free tier at https://console.groq.com/keys)
GROQ_API_KEY=your-groq-api-key-here

# Google Gemini — RAG embeddings + chat fallback when Groq is rate-limited
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Optional model overrides
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_MODEL=openai/gpt-oss-20b
# GEMINI_MODEL=gemini-3.6-flash
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001
