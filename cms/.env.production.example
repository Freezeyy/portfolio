# Copy to .env on your Raspberry Pi, then fill in real values.
# Generate secrets: openssl rand -base64 32

NODE_ENV=production
HOST=0.0.0.0
PORT=1337

# Public URL served by Cloudflare Tunnel (no trailing slash)
PUBLIC_URL=https://cms.yourdomain.com
BEHIND_PROXY=true

# Comma-separated — your Netlify site URL(s)
CORS_ORIGINS=https://your-site.netlify.app,https://yourdomain.com

# Required Strapi secrets (generate unique values for production!)
APP_KEYS=key1,key2,key3,key4
API_TOKEN_SALT=change-me
ADMIN_JWT_SECRET=change-me
TRANSFER_TOKEN_SALT=change-me
JWT_SECRET=change-me
ENCRYPTION_KEY=change-me

# SQLite (default — fine for a personal portfolio on Pi)
DATABASE_CLIENT=sqlite
DATABASE_FILENAME=.tmp/data.db
